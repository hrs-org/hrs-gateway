# Use Alpine-based runtime (smaller, fewer vulnerabilities)
FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS base
WORKDIR /app
EXPOSE 8080

# Use Alpine SDK for build
FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS build
ARG BUILD_CONFIGURATION=Release
ARG VERSION=1.0.0
WORKDIR /src

COPY ["HRS.Gateway.csproj", "./"]
RUN dotnet restore "HRS.Gateway.csproj"

COPY . .
RUN dotnet build "HRS.Gateway.csproj" -c $BUILD_CONFIGURATION -o /app/build /p:Version=$VERSION

FROM build AS publish
RUN dotnet publish "HRS.Gateway.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false /p:Version=$VERSION

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:8080

# Create non-root user with high UID (Alpine syntax)
RUN addgroup -g 10001 appgroup && adduser -u 10001 -G appgroup -D appuser && chown -R appuser /app
USER appuser

ENTRYPOINT ["dotnet", "HRS.Gateway.dll"]