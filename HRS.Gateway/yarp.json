{
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/users" }]
      },
      "store": {
        "ClusterId": "store-cluster",
        "Match": { "Path": "/api/store/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/store" }]
      },
      "orders": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/orders" }]
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user-api": {
            "Address": "http://hrs-user-service.user.svc.cluster.local/"
          }
        }
      },
      "store-cluster": {
        "Destinations": {
          "store-api": {
            "Address": "http://hrs-store-service.store.svc.cluster.local/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "orders-api": {
            "Address": "http://hrs-orders-service.orders.svc.cluster.local/"
          }
        }
      }
    }
  }
}
