{
  "ReverseProxy": {
    "Routes": {
      "user-health-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/health/users"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ],
        "Order": 1
      },
      "email-health-route": {
        "ClusterId": "email-service-cluster",
        "Match": {
          "Path": "/health/email"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ],
        "Order": 2
      },
      "auth-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "user-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "store-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/stores/{**catch-all}"
        }
      },
      "email-service-route": {
        "ClusterId": "email-service-cluster",
        "Match": {
          "Path": "/api/email/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-service-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://hrs-user-service.users.svc.cluster.local"
          }
        }
      },
      "email-service-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://hrs-email-service.email.svc.cluster.local"
          }
        }
      }
    }
  }
}
