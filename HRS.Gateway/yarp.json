{
  "ReverseProxy": {
    "Routes": {
      "user-health-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/health/users"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ],
        "Order": 1
      },
      "email-health-route": {
        "ClusterId": "email-service-cluster",
        "Match": {
          "Path": "/health/email"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ],
        "Order": 2
      },
      "maintenance-health-route": {
        "ClusterId": "maintenance-service-cluster",
        "Match": {
          "Path": "/health/maintenance"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ],
        "Order": 3
      },
      "payment-health-route": {
        "ClusterId": "payment-service-cluster",
        "Match": {
          "Path": "/health/payment"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ],
        "Order": 4
      },
      "inventory-health-route": {
        "ClusterId": "inventory-service-cluster",
        "Match": {
          "Path": "/health/inventory"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ],
        "Order": 5
      },
      "order-health-route": {
        "ClusterId": "order-service-cluster",
        "Match": {
          "Path": "/health/order"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ],
        "Order": 6
      },
      "auth-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "user-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "store-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/stores/{**catch-all}"
        }
      },
      "email-service-route": {
        "ClusterId": "email-service-cluster",
        "Match": {
          "Path": "/api/email/{**catch-all}"
        }
      },
      "maintenance-service-route": {
        "ClusterId": "maintenance-service-cluster",
        "Match": {
          "Path": "/api/item-maintenances/{**catch-all}"
        }
      },
      "payment-service-route": {
        "ClusterId": "payment-service-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "item-service-route": {
        "ClusterId": "inventory-service-cluster",
        "Match": {
          "Path": "/api/items/{**catch-all}"
        }
      },
      "package-service-route": {
        "ClusterId": "inventory-service-cluster",
        "Match": {
          "Path": "/api/packages/{**catch-all}"
        }
      },
      "catalog-service-route": {
        "ClusterId": "order-service-cluster",
        "Match": {
          "Path": "/api/catalogs/{**catch-all}"
        }
      },
      "order-service-route": {
        "ClusterId": "order-service-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-service-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://hrs-user-service.uat.svc.cluster.local"
          }
        }
      },
      "email-service-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://hrs-email-service.uat.svc.cluster.local"
          }
        }
      },
      "maintenance-service-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://hrs-maintenance-service.uat.svc.cluster.local"
          }
        }
      },
      "payment-service-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://hrs-payment-service.uat.svc.cluster.local"
          }
        }
      },
      "inventory-service-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://hrs-inventory-service.uat.svc.cluster.local"
          }
        }
      },
      "order-service-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://hrs-order-service.uat.svc.cluster.local"
          }
        }
      }
    }
  }
}
