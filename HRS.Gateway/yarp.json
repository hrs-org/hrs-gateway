{
  "ReverseProxy": {
    "Routes": {
      "user-health-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/health/users"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ],
        "Order": 1
      },
      "email-health-route": {
        "ClusterId": "email-service-cluster",
        "Match": {
          "Path": "/health/email"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ],
        "Order": 2
      },
      "maintenance-health-route": {
        "ClusterId": "maintenance-service-cluster",
        "Match": {
          "Path": "/health/maintenance"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ],
        "Order": 3
      },
      "payment-health-route": {
        "ClusterId": "payment-service-cluster",
        "Match": {
          "Path": "/health/payment"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ],
        "Order": 4
      },
      "auth-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "user-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "store-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/stores/{**catch-all}"
        }
      },
      "email-service-route": {
        "ClusterId": "email-service-cluster",
        "Match": {
          "Path": "/api/email/{**catch-all}"
        }
      },
      "maintenance-service-route": {
        "ClusterId": "maintenance-service-cluster",
        "Match": {
          "Path": "/api/maintenance/{**catch-all}"
        }
      },
      "payment-service-route": {
        "ClusterId": "payment-service-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-service-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://hrs-user-service.users.svc.cluster.local"
          }
        }
      },
      "email-service-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://hrs-email-service.email.svc.cluster.local"
          }
        }
      },
      "maintenance-service-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://hrs-maintenance-service.maintenance.svc.cluster.local"
          }
        }
      },
      "payment-service-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://hrs-payment-service.payments.svc.cluster.local"
          }
        }
      }
    }
  }
}
